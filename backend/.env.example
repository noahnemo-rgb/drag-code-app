# Copy to backend/.env and fill in values before starting the API.
#   cp backend/.env.example backend/.env

# MongoDB connection string (local docker-compose default shown)
MONGO_URL=mongodb://127.0.0.1:27017

# Database name used by Syntax IDE
DB_NAME=syntax_ide

# Require X-Device-Id on cloud project/file/run routes (tenant isolation)
REQUIRE_DEVICE_ID=true

# Max sandboxed code runs per device per UTC day (0 = unlimited)
RUN_DAILY_LIMIT=50

# Comma-separated CORS origins, or * for all
CORS_ORIGINS=*

# AI chat runs client-side:
#   Web  → Puter.js (user's Puter account)
#   iOS/Android → user's own OpenRouter API key (BYOK, stored on device)
# No OPENROUTER_API_KEY is needed on the server.
