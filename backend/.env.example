# Copy to backend/.env and fill in values before starting the API.
#   cp backend/.env.example backend/.env

# MongoDB connection string (local docker-compose default shown)
MONGO_URL=mongodb://127.0.0.1:27017

# Database name used by Syntax IDE
DB_NAME=syntax_ide

# JWT auth (required for cloud projects/files/chat when REQUIRE_AUTH=true)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_DAYS=30
REQUIRE_AUTH=true

# OpenRouter (https://openrouter.ai) — optional for server /api/chat/stream
# Client AI (Puter web / BYOK mobile) does not need this.
OPENROUTER_API_KEY=
# Any OpenRouter model slug, e.g. openai/gpt-4o-mini, anthropic/claude-3.5-sonnet
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_SITE_URL=https://syntax.ide
OPENROUTER_APP_NAME=Syntax Mobile IDE

# Dedicated runner (optional). When set, /api/run proxies here.
# RUNNER_URL=http://127.0.0.1:8001
# RUNNER_API_KEY=
# Local fallback sandbox: set true to refuse process sandbox without Docker
REQUIRE_DOCKER=false
# auto | true | false — CI should set false so process sandbox is used
SANDBOX_USE_DOCKER=auto

# Per-tier daily code runs (sandboxed /api/run)
FREE_RUN_DAILY_LIMIT=10
PRO_RUN_DAILY_LIMIT=50

# Per-tier monthly snippet publishes
FREE_SNIPPET_PUBLISH_MONTHLY=3
PRO_SNIPPET_PUBLISH_MONTHLY=100

# Comma-separated CORS origins, or * for all
CORS_ORIGINS=*
