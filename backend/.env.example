# Copy to backend/.env and fill in values before starting the API.
#   cp backend/.env.example backend/.env

# MongoDB connection string (local docker-compose default shown)
MONGO_URL=mongodb://127.0.0.1:27017

# Database name used by Syntax IDE
DB_NAME=syntax_ide

# LLM key used by /api/chat/stream (Emergent Integrations → Gemini)
# Leave empty to boot the API; chat endpoints will return 500 until set.
EMERGENT_LLM_KEY=
