# Copy to frontend/.env and fill in values before starting Expo.
#   cp frontend/.env.example frontend/.env
#
# Base URL of the FastAPI backend (no trailing slash).
# Expo only exposes vars prefixed with EXPO_PUBLIC_ to the app.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# AI is configured in-app (gear icon on the AI screen):
#   Web         → sign in to Puter when prompted (@heyputer/puter.js)
#   iOS/Android → add your OpenRouter API key (never sent to our backend)
